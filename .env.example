# ===== Servidor (Vercel → Settings → Environment Variables) =====
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRETA: nunca no front-end
SUPABASE_BUCKET=products

# Endereço público do site (opcional; sem isto usa o domínio da Vercel). Ex.: https://kydson.com.br
SITE_URL=

# Mercado Pago → Suas integrações → Credenciais de produção / Webhooks
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) — aviso automático de pedido pago para a loja
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=5511999999999             # número da loja que recebe o aviso (diferente do número da API)
WHATSAPP_TEMPLATE=pedido_pago
WHATSAPP_TEMPLATE_LANG=pt_BR

# ===== Front-end (embutidas no build; públicas) =====
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=               # chave "anon public"
VITE_WHATSAPP_NUMBER=5511999999999    # botão flutuante do site

# ===== Dados legais (aparecem na Política de Privacidade e nos Termos; deixe vazio o que não tiver) =====
VITE_LEGAL_NAME=                      # razão social
VITE_LEGAL_CNPJ=                      # 00.000.000/0000-00
VITE_CONTACT_EMAIL=                   # e-mail para pedidos de privacidade (LGPD) e atendimento
# Segredo do link de descadastro dos e-mails (servidor). Se vazio, usa a chave do Supabase como base.
UNSUBSCRIBE_SECRET=

# Segredo do agendamento (Vercel Cron) que exclui contas de clientes inativas há 24 meses. Vazio = desligado.
CRON_SECRET=
